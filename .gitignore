# Guardrail: this is the public tooling repo. Meeting content and audio must
# never land here - they belong in the private notes repo.
*.m4a
*.mp3
*.wav
*.mp4
*.caf
VoiceMemoInbox/

# Rendered LaunchAgent (install.sh writes it to ~/Library/LaunchAgents, but
# don't let a stray copy with real paths get committed).
*.plist
!launchd/*.plist.template
